# این فایل را کپی کرده و به نام .env ذخیره کنید:
#   cp .env.example .env
#
# فایل .env هرگز نباید Commit شود (در .gitignore قرار دارد).

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------

# با دستور زیر یک SECRET_KEY امن تولید کنید:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-real-random-secret-key

# development یا production
DJANGO_SETTINGS_MODULE=config.settings.development

# لیست دامنه‌های مجاز، جدا شده با کاما (فقط در production الزامی است).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_DB=trading_platform
POSTGRES_USER=trading_platform
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# CORS / CSRF (آدرس دقیق فرانت‌اند Next.js)
# ---------------------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000


